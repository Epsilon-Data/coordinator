# RabbitMQ Configuration
RABBITMQ_USER=
RABBITMQ_PASS=
# Database Configuration - Using existing Neon database
DATABASE_URL=
# OpenAI Configuration (required for CrewAI)
OPENAI_API_KEY=your_openai_api_key_here
# Shared Storage Configuration
# Path on the host machine where shared storage will be mounted
SHARED_STORAGE_HOST_PATH=./shared_storage
# Worker Configuration
CLONE_WORKER_REPLICAS=2
AI_AGENT_WORKER_REPLICAS=3
EXECUTOR_WORKER_REPLICAS=2