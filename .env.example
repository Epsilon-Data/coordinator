# ===========================================
# Epsilon Coordinator - Environment Variables
# ===========================================

# Database Configuration
# For local: postgresql://user:pass@localhost:5432/epsilon
# For AWS RDS: postgresql://user:pass@your-rds-endpoint.region.rds.amazonaws.com:5432/epsilon
DATABASE_URL=

# ===========================================
# AWS Configuration (Required for Executor)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=  # Optional, only for temporary credentials
AWS_KMS_KEY_ARN=
KMS_REGION=ap-southeast-2
S3_BUCKET=epsilon-datasets

# ===========================================
# Shared Storage Configuration
# ===========================================
# Local development: ./shared_storage
# EC2 deployment: /data/epsilon
SHARED_STORAGE_HOST_PATH=./shared_storage

# ===========================================
# Enclave Mode
# ===========================================
# 'true'  = Local simulation (no real Nitro Enclave)
# 'false' = Production with real Nitro Enclaves
USE_LOCAL_ENCLAVE=true

# ===========================================
# Middleware Configuration
# ===========================================
# Local: http://localhost:8001
# Docker: http://host.docker.internal:8001
# AWS Lambda: https://xxx.execute-api.region.amazonaws.com/prod/fetch-csv
MIDDLEWARE_ENDPOINT_URL=http://host.docker.internal:8001
MIDDLEWARE_TIMEOUT_SECONDS=60

# ===========================================
# Worker Configuration
# ===========================================
POLLING_INTERVAL=5

# AI Agent: 'true' to enable, 'false' to skip
AI_AGENT_ENABLED=false

# OpenAI (only required if AI_AGENT_ENABLED=true)
OPENAI_API_KEY=