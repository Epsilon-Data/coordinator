# Database Configuration - Using existing Neon database
DATABASE_URL=

# OpenAI Configuration (required for CrewAI)
OPENAI_API_KEY=your_openai_api_key_here

# AWS Configuration (Required for Executor)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=  # Optional, only for temporary credentials
AWS_KMS_KEY_ARN=
AWS_KMS_KEY_ID=  # Usually same as ARN, will default to ARN if not set
KMS_REGION=ap-southeast-2
S3_BUCKET=epsilon-datasets

# Executor Testing Mode
# Set to 'true' for local testing with real KMS but simulated enclave
# Set to 'false' for production with real Nitro Enclaves
USE_LOCAL_ENCLAVE=false

# Shared Storage Configuration
# Path on the host machine where shared storage will be mounted
SHARED_STORAGE_HOST_PATH=./shared_storage

# Worker Configuration
CLONE_WORKER_REPLICAS=2
AI_AGENT_WORKER_REPLICAS=3
EXECUTOR_WORKER_REPLICAS=2

# Job Processing Mode
# 'polling' for database polling (default and recommended)
# 'rabbitmq' for message queue based processing (deprecated)
JOB_FETCH_MODE=polling
POLLING_INTERVAL=5

# AI Agent Configuration
# Set to 'true' to enable AI agent analysis (job-fetch -> clone -> ai_agent -> executor)
# Set to 'false' to skip AI agent and go directly to executor (job-fetch -> clone -> executor)
AI_AGENT_ENABLED=true

# Middleware Configuration (Required for Executor)
# URL to the middleware service that fetches encrypted CSV data
# Local development: http://localhost:8001 or http://middleware:8001 (docker)
# Production: Set to your production middleware URL
MIDDLEWARE_ENDPOINT_URL=http://middleware:8001
MIDDLEWARE_TIMEOUT_SECONDS=60