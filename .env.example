# ===========================================
# Epsilon Coordinator - Environment Variables
# ===========================================

# ===========================================
# Docker Registry (Production)
# ===========================================
DOCKER_REGISTRY=ghcr.io/Epsilon-Data
VERSION=latest

# ===========================================
# Database Configuration
# ===========================================
# Local: postgresql://user:pass@localhost:5432/epsilon
# AWS RDS: postgresql://user:pass@your-rds-endpoint.region.rds.amazonaws.com:5432/epsilon
DATABASE_URL=postgresql://epsilon:epsilon@localhost:5432/epsilon

# ===========================================
# AWS Configuration (Required for Executor)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-2
# KMS key ARN for envelope encryption (required in production)
AWS_KMS_KEY_ARN=

# ===========================================
# Shared Storage Configuration
# ===========================================
# Host path mounted into containers (Docker Compose volume bind)
# Local development: ./shared_storage
# EC2 deployment: /data/epsilon
SHARED_STORAGE_HOST_PATH=./shared_storage
# Internal container path (used by workers)
SHARED_STORAGE_PATH=/shared/epsilon

# ===========================================
# Enclave Configuration
# ===========================================
# 'true'  = Local simulation (development)
# 'false' = Production with real Nitro Enclaves
USE_LOCAL_ENCLAVE=true
ENCLAVE_VSOCK_PORT=5005
# External enclave mode: enclave is managed separately (e.g. by systemd)
USE_EXTERNAL_ENCLAVE=false
# CID of the external enclave (required when USE_EXTERNAL_ENCLAVE=true)
# ENCLAVE_CID=18

# ===========================================
# Middleware Configuration
# ===========================================
# Local: http://localhost:8001
# Docker: http://host.docker.internal:8001
# Production: https://middleware.your-domain.com
MIDDLEWARE_ENDPOINT_URL=http://host.docker.internal:8001
MIDDLEWARE_TIMEOUT_SECONDS=60
# 'aws' = invoke via Lambda, 'local' = direct HTTP
MIDDLEWARE_MODE=local
# 'true' = fetch CSV directly from database instead of via middleware
MIDDLEWARE_DIRECT_DB=false

# ===========================================
# Project Access Check (Epsilon API)
# ===========================================
# Before any real data is requested, the executor asks the Epsilon API whether
# the job's submitter may analyse the job's project. Without these settings
# every job fails before real data.
# Base URL including the API's global prefix (its API_BASE_URL, default /api/v1/hub),
# e.g. https://app.epsilon-data.org/api/v1/hub; /coordinator/auth and
# /coordinator/<projectId> are appended to it. An internal API address that
# bypasses Cloudflare may be used instead, if one exists.
EPSILON_API_URL=
EPSILON_COORDINATOR_CLIENT_ID=coordinator-client
EPSILON_COORDINATOR_CLIENT_SECRET=
# 'enforce' (default) or 'disabled'; 'disabled' is honoured only when the
# resolved enclave backend is local (ENCLAVE_BACKEND=local, or ENCLAVE_BACKEND
# unset and USE_LOCAL_ENCLAVE=true); otherwise it is logged and ignored
PROJECT_ACCESS_CHECK=enforce
# The local enclave gives no authentic attestation, so reviewers cannot approve
# its results (RG009, 'not attested') unless the local dev database allows it:
#   ALTER DATABASE <db> SET epsilon.allow_unattested_release = on;
# Local/test databases only; never set this on production.

# ===========================================
# Output Files (Executor)
# ===========================================
# Files a real-data run writes are held for review with its output. Their bytes
# are stored under jobs/<job_id>/<sha256> in:
# 's3'    = OUTPUT_FILES_BUCKET (region AWS_REGION, default AWS credential chain);
#           SSE-KMS with OUTPUT_FILES_KMS_KEY_ID, else the bucket's default encryption
# 'local' = the directory OUTPUT_FILES_DIR
# Unset: a run that writes a file fails ("Output file store is not configured").
OUTPUT_FILES_STORE=
OUTPUT_FILES_BUCKET=
OUTPUT_FILES_KMS_KEY_ID=
OUTPUT_FILES_DIR=
# Limits re-checked by the coordinator (keep equal to the enclave's)
# MAX_OUTPUT_FILES=20
# MAX_OUTPUT_FILES_MB=10

# ===========================================
# Worker Configuration
# ===========================================
POLLING_INTERVAL=5
BATCH_SIZE=10
LOG_LEVEL=INFO
# 'development' or 'production'
ENVIRONMENT=development

# Scale executor workers (production)
EXECUTOR_REPLICAS=1

# ===========================================
# AI Agent
# ===========================================
AI_AGENT_ENABLED=true
OPENAI_API_KEY=
# LLM model for CrewAI agents.
# Pin to a specific snapshot for reproducibility (the bare alias "gpt-4o-mini"
# resolves to whichever snapshot OpenAI is currently serving, which can change).
# Recommended: gpt-4o-mini-2024-07-18 (the snapshot evaluated in our paper).
CREWAI_LLM_MODEL=gpt-4o-mini-2024-07-18
